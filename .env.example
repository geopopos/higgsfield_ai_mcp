# ==========================================
# Auto-MV Pipeline Environment Variables
# ==========================================

# 1. Higgsfield AI (Video-to-Video & Motion Control)
# https://cloud.higgsfield.ai/api-keys
HF_API_KEY=your_higgsfield_api_key
HF_SECRET=your_higgsfield_secret

# 2. Image Generation API Key (For Step 3 Character Sheets & Location Refs)
# Fal.ai (Recommended for FLUX.1): https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_key

# 3. Local Tool Paths (Optional overrides)
# BLENDER_PATH="C:\Program Files\Blender Foundation\Blender 4.2\blender.exe"
